<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Insight for Android.

      The only platform where a phone can honestly measure its own use. iOS
      gates that behind an entitlement Apple grants to parental-control
      companies; Android asks the student for a permission, in their own
      Settings, that they can take back at any time.

      PACKAGE_USAGE_STATS is that permission. It is not granted by tapping
      Allow — the student has to go to Settings and turn it on for this app
      specifically, which is friction we keep rather than route around,
      because it is also what makes the promise legible.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Close a blocked app rather than merely covering it.

      Showing a screen on top leaves the app running behind it, holding its
      state and waiting — so blocking felt like a curtain rather than a door.
      This is granted at install and only reaches apps in the background,
      which by then is exactly what a blocked app is.
    -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!--
      Draw over other apps. Two jobs: it is how a blocked app gets replaced
      with our own screen, and since Android 10 it is also what allows a
      background service to start an activity at all.

      Granted in Settings, like usage access, and revocable in the same place.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />

    <application
        android:allowBackup="false"
        android:label="Insight"
        android:supportsRtl="true"
        android:theme="@style/Theme.Insight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          What a blocked app is replaced with. Not in Recents: it is an
          interruption rather than somewhere you navigate to, and finding it
          in the app switcher afterwards would be confusing.
        -->
        <activity
            android:name=".BlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Insight" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          The tracker runs as a foreground service with a permanent
          notification. That is Android's rule, and it is the right rule: an
          app counting what you use should not be able to do it invisibly.
        -->
        <service
            android:name=".TrackerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Counts time per app during a study session the user started" />
        </service>
    </application>
</manifest>
