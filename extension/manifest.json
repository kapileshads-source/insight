{
  "manifest_version": 3,
  "name": "Insight",
  "version": "0.2.0",
  "description": "Records which sites you use during a study session, and blocks distracting ones while Focus Mode is on.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://insight-study-sleep.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://hac.friscoisd.org/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Insight",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://insight-study-sleep.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "hac-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
