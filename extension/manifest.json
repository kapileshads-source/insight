{
  "manifest_version": 3,
  "name": "Insight",
  "version": "0.1.0",
  "description": "Records which sites you use during a study session, and blocks distracting ones while Focus Mode is on.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Insight"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
