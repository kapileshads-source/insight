// Insight — data model
//
// ---------------------------------------------------------------------------
// A note on encryption, because it shapes nearly every model below.
//
// Student data is encrypted in the browser before it is sent here. The server
// stores ciphertext it cannot read and never possesses the key.
//
// The rule applied throughout is: STRUCTURE IS PLAINTEXT, CONTENT IS NOT.
// Row existence, foreign keys, and the timestamps needed for ordering,
// pagination and de-duplication stay readable. Everything a student would
// consider private — how long they slept, what they studied, what they scored,
// how stressed they were — lives inside `payloadCipher`.
//
// Each row carries one encrypted JSON blob rather than a column per encrypted
// field. That means one decrypt per row instead of many, and adding a new
// private field later needs no migration.
//
// What this deliberately leaks, and what the privacy policy must therefore
// admit to: that an account exists, its email and campus, how many rows it
// has, and when they were written.
//
// One carve-out: `CanvasConnection.accessToken` is encrypted with a SERVER key,
// not the student's, because the server has to call Canvas on their behalf.
// It is the only student secret the server can read, and the policy says so.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Schools, terms, bell schedules
//
// Admin-editable by design. FISD shifts schedules for early release, exam
// weeks, and semester changes, so no timing is hardcoded in application logic.
// ---------------------------------------------------------------------------

enum SchoolType {
  HIGH
  MIDDLE
}

/// Which set of classes meets on a given day.
/// FISD high schools alternate A and B; middle schools meet everything daily.
enum DayType {
  ALL
  A
  B
}

/// What times those classes run. Deliberately separate from DayType — a late
/// arrival A day is both an A day and a modified schedule, and folding the two
/// into one enum multiplies its cases every time a new variant appears.
enum ScheduleVariant {
  REGULAR
  LATE_ARRIVAL
  EARLY_RELEASE
}

model School {
  id   String     @id @default(cuid())
  name String     @unique
  type SchoolType

  /// How many periods must elapse between gap-filling prompts.
  /// 1 for high schools, 2 for middle schools.
  promptInterval Int @default(1)
  timezone       String @default("America/Chicago")

  periods   Period[]
  terms     Term[]
  users     User[]
  overrides ScheduleOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per period, per day-type, per schedule variant. Times are stored as
/// minutes-from-midnight in the school's local timezone, which keeps period
/// lookup a pure integer comparison and sidesteps DST entirely.
model Period {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  dayType DayType         @default(ALL)
  variant ScheduleVariant @default(REGULAR)

  /// Chronological position within the day, starting at 1.
  ///
  /// This exists separately from `number` because the two diverge. On a B day
  /// a high schooler's blocks are numbered 5, 6, 7, 8, and Advisory sits
  /// between the 2nd and 3rd block with no number at all. The prompt interval
  /// arithmetic needs consecutive ordering; the student needs to be told
  /// "3rd period". Using one field for both produces nonsense on B days.
  sequence Int

  /// Period number as students refer to it. Null for Advisory and similar.
  number Int?
  /// Display label for blocks without a number, or with a shared one.
  label  String?

  startMinutes Int
  endMinutes   Int

  /// Advisory and lunch count as time on campus but shouldn't necessarily
  /// advance the prompt counter the way an academic block does.
  isInstructional Boolean @default(true)

  @@unique([schoolId, dayType, variant, sequence])
  @@index([schoolId, dayType, variant])
}

/// A semester. FISD runs on semesters; prompt state resets at each boundary.
model Term {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  promptStates PromptState[]

  @@unique([schoolId, name])
  @@index([schoolId, startDate])
}

/// The district calendar: one row per dated school day.
///
/// A/B assignment cannot be computed by alternating from a start date. One
/// irregular day desynchronizes the rest of the year silently, and a student
/// being shown the wrong class is the kind of bug nobody reports — they just
/// stop trusting the app. So every date is stored explicitly, extracted from
/// the district's published calendar.
model DistrictCalendarDay {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date

  /// Null means no school that day.
  dayType DayType?
  variant ScheduleVariant @default(REGULAR)

  note String?

  @@index([date])
}

/// Campus-specific deviation from the district calendar.
model ScheduleOverride {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  date    DateTime        @db.Date
  dayType DayType?
  variant ScheduleVariant @default(REGULAR)
  note    String?

  @@unique([schoolId, date])
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

enum LaptopOs {
  WINDOWS
  MACOS
  CHROMEOS
  NONE
}

enum PhoneOs {
  IOS
  ANDROID
  NONE
}

model User {
  id String @id @default(cuid())
  /// Clerk user id. Source of truth for identity; we never store credentials.
  clerkId String @unique
  email   String @unique

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  /// Kept plaintext: needed to pick the right bell schedule and to route
  /// under-13 signups into the consent flow before anything else is collected.
  gradeLevel Int?
  birthDate  DateTime? @db.Date

  /// Which builds to offer on the download screen.
  laptopOs LaptopOs?
  phoneOs  PhoneOs?

  /// Baselines and preferences that are private to the student.
  /// Usual sleep and wake times, usual study noise level, usual location.
  profileCipher String?
  profileIv     String?

  onboardingCompletedAt DateTime?

  encryptionKey     EncryptionKey?
  parentConsent     ParentConsent?
  canvasConnection  CanvasConnection?
  deviceTokens      DeviceToken[]
  studySessions     StudySession[]
  sleepEntries      SleepEntry[]
  screenTimeEntries ScreenTimeEntry[]
  courses           Course[]
  assignments       Assignment[]
  outcomes          Outcome[]
  insights          Insight[]
  promptStates      PromptState[]
  mutedCategories   MutedInsightCategory[]
  recommendations   Recommendation[]
  dataGaps          DataGap[]
  pendingDeviceData PendingDeviceData[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

/// The student's encryption setup.
///
/// A passphrase derives a key-encryption key, which wraps a randomly generated
/// data-encryption key. Only the wrapped form is stored. This indirection means
/// changing the passphrase re-wraps one small key rather than re-encrypting a
/// year of study data.
///
/// The passphrase itself never reaches this server, which also means it cannot
/// be reset. Losing it loses the data — permanently and by design.
model EncryptionKey {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kdf        String @default("PBKDF2-SHA256")
  iterations Int    @default(600000)
  /// Base64. Public by design — a salt is not a secret.
  salt       String

  /// The data key, encrypted under the key derived from the passphrase.
  wrappedDek String
  wrapIv     String

  /// Encrypts a known constant, so the client can tell a wrong passphrase from
  /// corrupt data without decrypting anything real.
  verifierCipher String
  verifierIv     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// COPPA consent for students under 13. Nothing beyond the parent's email and
/// the child's account shell is collected until `confirmedAt` is set.
model ParentConsent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentEmail String
  /// SHA-256 of the emailed confirmation token.
  tokenHash   String  @unique

  requestedAt DateTime  @default(now())
  confirmedAt DateTime?
  revokedAt   DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Canvas
// ---------------------------------------------------------------------------

model CanvasConnection {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  baseUrl String

  /// Encrypted with the SERVER key, not the student's. The server must be able
  /// to call Canvas on their behalf, so this is the one student secret it can
  /// read. Called out explicitly in the privacy policy.
  accessToken String
  tokenIv     String

  /// FISD forces a 90-day maximum on personal access tokens, so this is a
  /// recurring event rather than an edge case. A token issued on the first day
  /// of school expires around five weeks before December finals.
  expiresAt     DateTime?
  lastSyncedAt  DateTime?
  lastSyncError String?
  /// Set when Canvas returns 401. Distinguishes "connection dead" from
  /// "no assignments", which must never be conflated.
  disconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Opaque Canvas identifier. Stored as a string because Canvas ids are
  /// 64-bit and JavaScript loses precision above 2^53.
  canvasId String?
  active   Boolean @default(true)

  /// Course name and short name.
  payloadCipher String
  payloadIv     String

  assignments   Assignment[]
  studySessions StudySession[]
  outcomes      Outcome[]

  @@unique([userId, canvasId])
  @@index([userId])
}

model Assignment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  canvasId String?
  /// Plaintext so the dashboard can order by what's next without decrypting
  /// every row first.
  dueAt    DateTime?

  /// Assignment name, points possible, submission state.
  payloadCipher String
  payloadIv     String

  outcome Outcome?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, canvasId])
  @@index([userId, dueAt])
}

enum OutcomeSource {
  CANVAS
  MANUAL
}

/// A graded result. Canvas-sourced and hand-entered outcomes share this table
/// so reconciliation is a single-table concern.
model Outcome {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  assignmentId String?     @unique
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  source     OutcomeSource
  occurredOn DateTime      @db.Date

  /// Set when a hand-entered score and a Canvas grade describe the same
  /// assessment but disagree, so the UI can ask which is right rather than
  /// silently picking one.
  conflictsWithSource OutcomeSource?

  /// Points earned, points possible, percentage, and any free-text label.
  payloadCipher String
  payloadIv     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredOn])
}

// ---------------------------------------------------------------------------
// Study sessions and the signals attached to them
// ---------------------------------------------------------------------------

model StudySession {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  /// Plaintext: the running timer needs them, and "this week" has to be
  /// answerable without pulling and decrypting the whole history.
  startedAt DateTime
  endedAt   DateTime?

  /// Location, noise level, stress, self-rated difficulty, cram flag,
  /// distracted seconds, focus mode state.
  payloadCipher String?
  payloadIv     String?

  activity    ExtensionActivity[]
  blockEvents FocusBlockEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
}

/// Per-domain time within a session, reported by the browser extension.
model ExtensionActivity {
  id        String       @id @default(cuid())
  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Domain and seconds. Which sites a student visits is exactly the kind of
  /// thing this whole design exists to keep private.
  payloadCipher String
  payloadIv     String

  recordedAt DateTime @default(now())

  @@index([sessionId])
}

model FocusBlockEvent {
  id        String       @id @default(cuid())
  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  payloadCipher String
  payloadIv     String

  occurredAt DateTime @default(now())

  @@index([sessionId])
}

/// Prior night's sleep, keyed to the morning it applies to.
model SleepEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Plaintext so a second entry for the same night can be caught without
  /// decrypting. Leaks that they logged sleep, not how much.
  forDate DateTime @db.Date

  payloadCipher String
  payloadIv     String

  createdAt DateTime @default(now())

  @@unique([userId, forDate])
}

enum ScreenTimeSource {
  OCR_IOS
  OCR_ANDROID
  NATIVE_WINDOWS
  NATIVE_MACOS
  NATIVE_ANDROID
  MANUAL
}

/// A daily screen-time total.
///
/// Screenshots are read on the student's own device and never uploaded. Only
/// the confirmed number is stored, and only in encrypted form.
model ScreenTimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  forDate DateTime         @db.Date
  source  ScreenTimeSource

  /// Minutes, the raw OCR reading, and whether the student edited it.
  payloadCipher String
  payloadIv     String

  createdAt DateTime @default(now())

  @@unique([userId, forDate, source])
  @@index([userId, forDate])
}

// ---------------------------------------------------------------------------
// Devices
// ---------------------------------------------------------------------------

enum DeviceKind {
  BROWSER_EXTENSION
  WINDOWS_APP
  MACOS_APP
  ANDROID_APP
}

/// Token handshake shared by the extension and the native apps.
model DeviceToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind DeviceKind
  /// SHA-256 of the token. The plaintext is shown once at pairing and never
  /// stored.
  tokenHash String  @unique
  label     String?

  lastSeenAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, kind])
}

/// A staging area for data from devices that hold no encryption key.
///
/// The extension and native apps can't encrypt on their own, so they post here
/// and the student's browser picks it up on next load, encrypts it, writes it
/// to the real tables, and deletes the row. Rows are short-lived by design and
/// swept after `expiresAt` whether or not they were collected.
model PendingDeviceData {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind    DeviceKind
  /// Raw JSON, readable by the server. This is the weak point of the whole
  /// design and the reason these rows live for hours rather than forever.
  payload Json

  receivedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId, receivedAt])
}

// ---------------------------------------------------------------------------
// Gap-filling prompt state
// ---------------------------------------------------------------------------

/// How far through the period sequence a student has been prompted, per term.
/// Scoping to a term means the reset at each semester boundary is automatic.
model PromptState {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  /// The date the last prompt fired, so the counter resets each school day.
  lastPromptedOn       DateTime? @db.Date
  /// Chronological position, matching Period.sequence rather than the number
  /// shown to the student.
  lastPromptedSequence Int?
  postTermPromptShown  Boolean   @default(false)

  updatedAt DateTime @updatedAt

  @@unique([userId, termId])
}

// ---------------------------------------------------------------------------
// Data gaps
// ---------------------------------------------------------------------------

enum GapSource {
  CANVAS
  EXTENSION
  SCREEN_TIME
}

/// A stretch of time where a data source went silent.
///
/// Without this, a dead Canvas token reads as "no assignments were due" and
/// three weeks of missing extension data reads as "they weren't distracted".
/// Both quietly distort the correlations. The insight engine excludes these
/// windows rather than treating absence as a zero.
model DataGap {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source    GapSource
  startedAt DateTime
  endedAt   DateTime?
  reason    String?

  @@index([userId, source, startedAt])
}

// ---------------------------------------------------------------------------
// Insights
// ---------------------------------------------------------------------------

enum InsightCategory {
  SLEEP
  STUDY_TIMING
  SESSION_LENGTH
  LOCATION
  NOISE
  PHONE_USAGE
  DISTRACTION
  WELLBEING
}

/// A computed, sample-size-gated correlation.
///
/// Computed in the browser now, since the server can't read the data it would
/// need. Still produced entirely by statistics — no model is involved in
/// finding a pattern, only in phrasing one that already passed the gates.
model Insight {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Plaintext so the dashboard can count and filter without decrypting, and
  /// so a student can mute a category. Which factor is being measured is far
  /// less revealing than the finding itself.
  category InsightCategory
  factor   String

  /// Direction, magnitude, threshold, sample size, counter-examples, and how
  /// many subjects and weeks it held across.
  payloadCipher String
  payloadIv     String

  /// False until every gate passes. Ungated rows are kept so the UI can say
  /// "log more to strengthen this" without a separate storage path.
  isSurfaced      Boolean  @default(false)
  firstComputedAt DateTime @default(now())
  lastComputedAt  DateTime @updatedAt

  recommendations Recommendation[]

  @@unique([userId, factor])
  @@index([userId, isSurfaced])
}

model MutedInsightCategory {
  id       String          @id @default(cuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category InsightCategory

  mutedAt DateTime @default(now())

  @@unique([userId, category])
}

/// Model-phrased advice, always derived from an already-validated Insight.
///
/// The browser decrypts the finished insight and sends only that compact
/// object through the server to the provider. The model phrases; it never
/// discovers, and it never sees a raw session log.
model Recommendation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  insights Insight[]

  payloadCipher String
  payloadIv     String

  /// Kept plaintext for auditing wording problems later.
  provider String
  model    String

  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}
